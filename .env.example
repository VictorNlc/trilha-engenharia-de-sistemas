# Copie este arquivo para .env.local (dev) e configure as mesmas chaves
# como Environment Variables no projeto da Vercel (produção).

# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Painel do Supabase > Project Settings > API > service_role
# NUNCA exponha esta chave no client — só é usada em rotas de servidor (app/api/**).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# URL pública do site (usada em links de callback de autenticação)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
